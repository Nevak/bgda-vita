// Cg Fragment Shader
#define D3D_ALPHA_TEST 1

#if D3D_ALPHA_TEST
    // Define the alpha test parameters if D3D_ALPHA_TEST is enabled
    uniform float2 D3D_ALPHA_REF_SIGN;  // Corresponds to "D3D_ALPHA_REF_SIGN_TYPE mediump vec2"
#endif

// Texture sampler
//sampler2D u0;

// Varyings passed from the vertex shader
float4 main(
    float2 oT0 : TEXCOORD0,   // Texture coordinate (equivalent to "VARYING_oT0(highp vec2)")
    float4 oD0 : COLOR0,  // Color input (equivalent to "VARYING_oD0(lowp vec4)")
    uniform sampler2D u0 : TEXUNIT0
) : COLOR
{
    // Sample the texture
    float4 texColor = tex2D(u0, oT0);
    
    // Compute the output color, multiplying by 2.0
    float4 color = oD0 * texColor * 2.0;

#if D3D_ALPHA_TEST
    // Perform alpha testing if enabled
    // Equivalent to the GLSL macro:
    // if( sign(floor(color.a * 255.0) - D3D_ALPHA_REF_SIGN.x) != D3D_ALPHA_REF_SIGN.y ) { discard; }
    float testVal = floor(color.a * 255.0) - D3D_ALPHA_REF_SIGN.x;
    if (sign(testVal) != D3D_ALPHA_REF_SIGN.y)
    {
        // Discard the fragment (equivalent to GLSL "discard")
        clip(-1.0);
    }
#endif
    
    return color;
}
