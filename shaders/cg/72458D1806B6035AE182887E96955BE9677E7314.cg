// profile sce_vp_psp2

// We assume a profile like "vs_3_0" or "arbvp1" which supports enough registers.
// Compile with, for example:
//   cgc -profile vs_3_0 -entry main MyShader.cg
// or an equivalent approach in your engine.

// 1) Large uniform array (c[115]), matching the range [0..114].
uniform float4 c[115];

// 2) Additional uniform for screenspace transform
uniform float4 D3D_SCR_CST;

// Helper macro for screenspace offset/scale, as in your GLSL
#define screenspace(var) \
    { var.xy += D3D_SCR_CST.xy; \
      var.xy *= D3D_SCR_CST.zw; }

// Helper function to access c[]
float4 C(int idx) { return c[idx]; }

// -----------------------------------------------------------------------------
// main() with old-style Cg semantics, preserving attribute names for GL lookups
// -----------------------------------------------------------------------------
void main(
    float4 v0 : ATTR0,   // was "attribute vec4 v0"
    float4 v2 : ATTR2,   // was "attribute vec4 v2"
    float2 v9 : ATTR9,   // was "attribute vec2 v9"
    
    out float4 oPos : POSITION,   // gl_Position
    out float4 oD0  : COLOR0,     // varying vec4 oD0
    out float2 oT0  : TEXCOORD0,  // varying vec2 oT0
    out float2 oT1  : TEXCOORD1   // varying vec2 oT1
)
{
    // Macros from GLSL to keep the code consistent
    #define inPos     v0
    #define inNormal  v2
    #define inTexCoord v9

    // ---------------------------------------------------------------
    // Translate position by c[96].xyz
    // ---------------------------------------------------------------
    float3 transPos = (inPos.xyz) + C(96).xyz;

    // Build final homogeneous position in oPos
    oPos = transPos.x * C(97);
    oPos += transPos.y * C(98);
    oPos += transPos.z * C(99);
    oPos += C(100);

    // ---------------------------------------------------------------
    // Compute light vectors vs. transPos, stored in c[3..8] etc.
    // lvx = (lightPos1 - transPos.xxxx), etc.
    // ---------------------------------------------------------------
    float4 lvx       = C(3)  - transPos.xxxx;
    float4 lvx_extra = C(4)  - transPos.xxxx;
    float4 lvy       = C(5)  - transPos.yyyy;
    float4 lvy_extra = C(6)  - transPos.yyyy;
    float4 lvz       = C(7)  - transPos.zzzz;
    float4 lvz_extra = C(8)  - transPos.zzzz;

    // ---------------------------------------------------------------
    // dist2 = lvx^2 + lvy^2 + lvz^2, etc.
    // ---------------------------------------------------------------
    float4 dist2       = lvx * lvx;
    float4 dist2_extra = lvx_extra * lvx_extra;
    dist2       += lvy       * lvy;
    dist2_extra += lvy_extra * lvy_extra;
    dist2       += lvz       * lvz;
    dist2_extra += lvz_extra * lvz_extra;

    // distdiff = dist2 - lightradius
    // lightamount = distdiff * lightfalloff
    float4 distdiff       = dist2       - C(9);
    float4 distdiff_extra = dist2_extra - C(10);
    float4 lightamount       = distdiff       * C(11);
    float4 lightamount_extra = distdiff_extra * C(12);

    // ---------------------------------------------------------------
    // Normalize the direction vectors, then do dot(inNormal, lv)
    // ---------------------------------------------------------------
    float4 invsq       = 1.0 / sqrt(dist2);
    float4 invsq_extra = 1.0 / sqrt(dist2_extra);

    // Multiply lv by inverse length
    lvx       *= invsq;
    lvx_extra *= invsq_extra;
    lvy       *= invsq;
    lvy_extra *= invsq_extra;
    lvz       *= invsq;
    lvz_extra *= invsq_extra;

    // Dot with inNormal
    float4 ndot       = lvx       * inNormal.x;
    float4 ndot_extra = lvx_extra * inNormal.x;
    ndot       += lvy       * inNormal.y;
    ndot_extra += lvy_extra * inNormal.y;
    ndot       += lvz       * inNormal.z;
    ndot_extra += lvz_extra * inNormal.z;

    // Clamp to [0..1], multiply by lightamount
    ndot       = max(ndot, 0.0);
    ndot_extra = max(ndot_extra, 0.0);
    lightamount       *= ndot;
    lightamount_extra *= ndot_extra;

    lightamount       = clamp(lightamount,       0.0, 1.0);
    lightamount_extra = clamp(lightamount_extra, 0.0, 1.0);

    // ---------------------------------------------------------------
    // Combine into final lightColor
    //  c[13..16] + c[17..20] hold the light colors, ambient in c[111]
    // ---------------------------------------------------------------
    float4 lightColor = lightamount.x * C(13);
    lightColor       += lightamount.y * C(14);
    lightColor       += lightamount.z * C(15);
    lightColor       += lightamount.w * C(16);
    lightColor       += lightamount_extra.x * C(17);
    lightColor       += lightamount_extra.y * C(18);
    lightColor       += lightamount_extra.z * C(19);
    lightColor       += lightamount_extra.w * C(20);
    lightColor       += C(111); // ambient

    // Output min(lightColor, 1.0)
    oD0 = min(lightColor, 1.0);

    // ---------------------------------------------------------------
    // Pass through texture coordinate
    // ---------------------------------------------------------------
    oT0 = inTexCoord;

    // ---------------------------------------------------------------
    // r11.x = dot(inNormal, c[112]) => refMat1
    // r11.y = dot(inNormal, c[113]) => refMat2
    // oT1 = (oPos.xy / oPos.w) * c[114].x + r11
    // ---------------------------------------------------------------
    float2 r11;
    r11.x = dot(inNormal, C(112));  // dot with refMat1
    r11.y = dot(inNormal, C(113));  // dot with refMat2

    float2 screenPos = (oPos.xy / oPos.w) * C(114).x;
    oT1 = screenPos + r11;

    // ---------------------------------------------------------------
    // Final screenspace offset: oPos.xyz += c[0].xyz
    // ---------------------------------------------------------------
    oPos.xyz += C(0).xyz;

    // screenspace macro
    screenspace(oPos);
}
