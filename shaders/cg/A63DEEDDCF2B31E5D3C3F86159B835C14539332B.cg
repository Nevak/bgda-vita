// profile sce_fp_psp2

//sampler2D u0 : TEXUNIT0; // Equivalent to "uniform lowp sampler2D u0;"

void main(
    float4 out outColor : COLOR,
    float2 oT0 : TEXCOORD0, // Matches "VARYING_oT0(noperspective mediump vec2)" in GLSL
    uniform sampler2D u0 : TEXUNIT0
)
{
    // Sample the texture at oT0 and output the color
    oT0.y = 1.0 - oT0.y;
    outColor = tex2D(u0, oT0);
}
