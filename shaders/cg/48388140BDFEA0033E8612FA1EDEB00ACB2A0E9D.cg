// profile sce_vp_psp2

// Uniform array c[101], matching D3D_END_CONST = 101
uniform float4 c[101];

// Additional uniform for screen-space transform
uniform float4 D3D_SCR_CST;

// Helper macro to mimic screenspace(var)
#define screenspace(var) \
    { var.xy += D3D_SCR_CST.xy; \
      var.xy *= D3D_SCR_CST.zw; }

// Helper function to replicate #define C(idx) c[idx]
float4 C(int idx)
{
    return c[idx];
}

// The main entry point, preserving attribute names
void main(
    // Attributes
    float4 v0 : ATTR0,    // was "attribute vec4 v0" => inPos
    float2 v1 : ATTR1,    // was "attribute vec2 v1" => inTexCoord
    float4 v2 : ATTR2,    // was "attribute vec4 v2"

    // Outputs
    out float4 oPos : POSITION,  // gl_Position
    out float2 oT0  : TEXCOORD0, // varying vec2
    out float4 oD0  : COLOR0     // varying vec4
)
{
    // For clarity, define local macros or variables matching your GLSL
    #define inPos      v0
    #define inTexCoord v1

    // Reproduce your GLSL transformations:
    //   oPos = inPos.x*C(97) + inPos.y*C(98) + inPos.z*C(99) + C(100)
    float4 pos = inPos.x * C(97);
    pos       += inPos.y * C(98);
    pos       += inPos.z * C(99);
    pos       += C(100);

    // Copy texture coordinate and color
    oT0 = inTexCoord;
    oD0 = v2;

    // Shift pos.xyz by c[0].xyz, then apply screenspace macro
    pos.xyz += C(0).xyz;
    screenspace(pos);

    // Output final position
    oPos = pos;
}
