// Cg Vertex Shader

// We have two uniforms:
//   1) c[0]: a single float4 from the array c[] (like "uniform vec4 c[1];")
//   2) D3D_SCR_CST: used for the screen-space transform.


// A small macro to do the screen-space adjustment
#define screenspace(var) var.xy += D3D_SCR_CST.xy; var.xy *= D3D_SCR_CST.zw;

// The main vertex function, with input attributes and output varyings specified by semantics.
void main(
    // Input attributes
    in  float4 v0 : POSITION,   // ATTRIBUTE_v0(highp vec4)
    in  float2 v1 : TEXCOORD0,  // ATTRIBUTE_v1(highp vec2)
    in  float4 v2 : COLOR0,  // ATTRIBUTE_v2(highp vec4)
    
    // Output varyings
    out float4 oPos : POSITION, // Equivalent to gl_Position
    out float2 oT0  : TEXCOORD0,// Equivalent to VARYING_oT0(mediump vec2)
    out float4 oD0  : COLOR0, // Equivalent to VARYING_oD0(highp vec4)
    uniform float4 c,
    uniform float4 D3D_SCR_CST
)
{
    // Pass inputs directly to outputs
    oPos = v0;
    oT0  = v1;
    oD0  = v2;

    // Add c[0].xyz to the position (translating the vertex)
    oPos.xyz += c.xyz;

    // Apply screen space transform
    screenspace(oPos);

    // Divide z by 65535.0 * 256.0
    oPos.z /= (65535.0 * 256.0);
}
