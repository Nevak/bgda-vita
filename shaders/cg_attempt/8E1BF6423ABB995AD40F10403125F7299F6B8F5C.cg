struct VS_INPUT
{
    float4 inPos      : POSITION;   // corresponds to "ATTRIBUTE_v0(float4)"
    float4 inBoneData : TEXCOORD1;  // corresponds to "ATTRIBUTE_v1(float4)"
    float4 inNormal   : TEXCOORD2;  // corresponds to "ATTRIBUTE_v2(float4)"
    float2 inTexCoord : TEXCOORD3;  // corresponds to "ATTRIBUTE_v9(float2)"
};

// We’ll output position plus the varyings that will go to the fragment shader.
struct VS_OUTPUT
{
    float4 oPos : POSITION;  // equivalent to 'gl_Position'
    float4 oD0  : TEXCOORD0; // equivalent to 'varying float4 oD0'
    float2 oT0  : TEXCOORD1; // equivalent to 'varying float2 oT0'
    float2 oT1  : TEXCOORD2; // equivalent to 'varying float2 oT1'
};

// Matches 'uniform float4 c[192];' in your GLSL, used for bone matrices and lights.
uniform float4 c[192];

// Matches 'uniform float4 D3D_SCR_CST;' in your GLSL, used for screen-space adjustment.
uniform float4 D3D_SCR_CST;

VS_OUTPUT main(VS_INPUT IN)
{
    VS_OUTPUT OUT;

    // -------------------------------------------------------------------------
    // 1. Retrieve bone matrices from c[] using inBoneData (which has two bone indices & weights).
    //    boneStart = 10 in your GLSL code
    // -------------------------------------------------------------------------
    const int boneStart = 10;

    // First bone index & weight
    int a0 = (int)IN.inBoneData.x;
    float weight0 = IN.inBoneData.y;
    float4 r3 = c[a0 + boneStart]     * weight0;
    float4 r4 = c[a0 + 1 + boneStart] * weight0;
    float4 r5 = c[a0 + 2 + boneStart] * weight0;
    float4 r6 = c[a0 + 3 + boneStart] * weight0;

    // Second bone index & weight
    a0 = (int)IN.inBoneData.z;
    float weight1 = IN.inBoneData.w;
    r3 += c[a0 + boneStart]     * weight1;
    r4 += c[a0 + 1 + boneStart] * weight1;
    r5 += c[a0 + 2 + boneStart] * weight1;
    r6 += c[a0 + 3 + boneStart] * weight1;

    // -------------------------------------------------------------------------
    // 2. Transform position by weighted bone matrices
    // -------------------------------------------------------------------------
    OUT.oPos  = IN.inPos.x * r3;
    OUT.oPos += IN.inPos.y * r4;
    OUT.oPos += IN.inPos.z * r5;
    OUT.oPos += r6;

    // -------------------------------------------------------------------------
    // 3. Transform normal by the same bone matrices
    // -------------------------------------------------------------------------
    float4 tnormal  = IN.inNormal.x * r3;
           tnormal += IN.inNormal.y * r4;
           tnormal += IN.inNormal.z * r5;

    // -------------------------------------------------------------------------
    // 4. Per-vertex lighting:
    //    - dot(normal, 3 directional light vectors) => clamp(0.0)
    //    - accumulate multiple light contributions + ambient
    // -------------------------------------------------------------------------
    float4 lightAmount = tnormal.x * c[1];  // lightDir0
           lightAmount += tnormal.y * c[2]; // lightDir1
           lightAmount += tnormal.z * c[3]; // lightDir2
    // clamp negative to 0
    lightAmount = max(lightAmount, 0.0);

    float4 lightColor = lightAmount.x * c[4];  // lightColors0
    lightColor        += lightAmount.y * c[5]; // lightColors1
    lightColor        += lightAmount.z * c[6]; // lightColors2
    lightColor        += lightAmount.w * c[7]; // lightColors3
    lightColor        += c[8];                 // ambient

    // saturate final color to 1.0
    OUT.oD0 = min(lightColor, 1.0);

    // -------------------------------------------------------------------------
    // 5. Pass the texture coordinate
    // -------------------------------------------------------------------------
    OUT.oT0 = IN.inTexCoord;

    // -------------------------------------------------------------------------
    // 6. Compute oT1 from the normal (tnormal.xy) and c[191]
    //    In your GLSL: "oT1 = tnormal.xy * C(191).xy + C(191).ww;"
    //    c[191].ww is float2(c[191].w, c[191].w) in GLSL swizzling
    // -------------------------------------------------------------------------
    float2 offset2D = float2(c[191].w, c[191].w);
    OUT.oT1 = tnormal.xy * c[191].xy + offset2D;

    // -------------------------------------------------------------------------
    // 7. Apply a final translation and screen-space scaling from c[0] and D3D_SCR_CST
    // -------------------------------------------------------------------------
    OUT.oPos.xyz += c[0].xyz;         // "oPos.xyz += C(0).xyz;"
    // screenspace macro => oPos.xy += D3D_SCR_CST.xy; then oPos.xy *= D3D_SCR_CST.zw;
    OUT.oPos.xy += D3D_SCR_CST.xy;
    OUT.oPos.xy *= D3D_SCR_CST.zw;

    return OUT;
}
