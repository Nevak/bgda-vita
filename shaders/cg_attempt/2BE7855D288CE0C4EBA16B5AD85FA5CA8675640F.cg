// Cg Fragment Shader

// Uniforms (equivalent to 'uniform sampler2D u0;' and 'uniform float3 D3D_GAMMA_FACTORS;' in GLSL)
sampler2D u0;
float3 D3D_GAMMA_FACTORS;

// The main entry point of the fragment shader.
// The 'TEXCOORD0' semantic corresponds to the varying 'oT0' in GLSL.
float4 main(float2 oT0 : TEXCOORD0) : COLOR
{
    // Sample the texture.
    float4 pix = tex2D(u0, oT0);

    // Apply gamma correction to the RGB components.
    // (Equivalent to 'pow(pix.rgb, D3D_GAMMA_FACTORS)' in GLSL.)
    pix.rgb = pow(pix.rgb, D3D_GAMMA_FACTORS);

    // Return the final color (equivalent to 'gl_FragColor').
    return pix;
}
