// Cg Fragment Shader

#if D3D_ALPHA_TEST
    // In GLSL, this was declared if D3D_ALPHA_TEST was enabled.
    // We do the same here in Cg, defining a uniform float2 for alpha testing.
    uniform float2 D3D_ALPHA_REF_SIGN;
#endif

// GLSL had "uniform sampler2D u0;"
sampler2D u0;

// Match the GLSL varyings: oD0 (float4) and oT0 (float2).
// We'll pass them in using TEXCOORD semantics.
float4 main(float4 oD0 : TEXCOORD0,
            float2 oT0 : TEXCOORD1) : COLOR
{
    // Multiply the interpolated color (oD0) by the texture sample and scale by 2.0
    float4 color = oD0 * tex2D(u0, oT0) * 2.0;

#if D3D_ALPHA_TEST
    // Perform the alpha test similar to D3D_ALPHA_TEST_OP in GLSL:
    // if ( sign(floor(alpha*255.0) - D3D_ALPHA_REF_SIGN.x) != D3D_ALPHA_REF_SIGN.y ) { discard; }
    float testVal = floor(color.a * 255.0) - D3D_ALPHA_REF_SIGN.x;
    if (sign(testVal) != D3D_ALPHA_REF_SIGN.y)
    {
        // Discard the fragment by clipping with a negative value
        clip(-1.0);
    }
#endif

    return color;  // Equivalent to gl_FragColor in GLSL
}
