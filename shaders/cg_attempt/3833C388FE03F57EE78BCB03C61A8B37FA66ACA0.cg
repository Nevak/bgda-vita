// Cg Fragment Shader

// Uniform texture samplers (precision qualifiers are omitted in Cg)
sampler2D u0;
sampler2D u1;

// The fragment shader receives the following varyings:
//   - oD0: an interpolated float4 (mapped to TEXCOORD0)
//   - oT0: an interpolated texture coordinate (float2, TEXCOORD1)
//   - oT1: a second texture coordinate (float2, TEXCOORD2)
float4 main(
    float4 oD0 : TEXCOORD0,
    float2 oT0 : TEXCOORD1,
    float2 oT1 : TEXCOORD2
) : COLOR
{
    // Sample the two textures.
    float4 t0 = tex2D(u0, oT0);
    float4 t1 = tex2D(u1, oT1);
    
    // Compute a blend: (1 - t0.a)*t1 + t0
    float4 r0 = (1.0 - t0.a) * t1 + t0;
    
    // Multiply the result by the varying color and a constant factor.
    float4 color = r0 * oD0 * 2.0;
        
    return color;
}
