// Cg Fragment Shader

// If you enable alpha test (D3D_ALPHA_TEST = 1), define the alpha reference uniform.
#if D3D_ALPHA_TEST
    uniform float2 D3D_ALPHA_REF_SIGN;  // same as D3D_ALPHA_REF_SIGN_TYPE float2
#endif

// The texture sampler (equivalent to "uniform sampler2D u0;" in GLSL)
sampler2D u0;

// The main fragment entry point. 
// Matches the GLSL varyings: "oD0 (float4)" and "oT0 (float2)" 
// as TEXCOORD0 and TEXCOORD1 respectively.
float4 main(float4 oD0 : TEXCOORD0,
            float2 oT0 : TEXCOORD1) : COLOR
{
    // Sample the texture at oT0
    float4 t0 = tex2D(u0, oT0);
    
    // Multiply by the varying color (oD0) scaled by 2.0
    float4 color = oD0 * t0 * 2.0;
    
    // RGB *= (1.0 - alpha)
    color.rgb *= 1.0 - color.a;
    
    // alpha = 1.0 - t0.a
    color.a = 1.0 - t0.a;
    
#if D3D_ALPHA_TEST
    // Equivalent to the GLSL macro:
    //   if ( sign( floor(alpha * 255.0) - D3D_ALPHA_REF_SIGN.x ) != D3D_ALPHA_REF_SIGN.y ) { discard; }
    float testVal = floor(color.a * 255.0) - D3D_ALPHA_REF_SIGN.x;
    if (sign(testVal) != D3D_ALPHA_REF_SIGN.y)
    {
        // "discard" in GLSL => "clip(-1)" in Cg
        clip(-1.0);
    }
#endif
    
    // Return the final color (equivalent to "gl_FragColor")
    return color;
}
